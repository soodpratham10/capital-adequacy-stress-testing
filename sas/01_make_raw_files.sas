/*=====================================================================
  01_make_raw_files.sas
  Enough for the Worst Year: Chapter 1, Meet the Insurer

  Creates Northgate Public Auto's three raw data files, the way an
  analyst would receive them from the company's systems:

     data/raw_policies.csv   every policy written in 2025 and 2026
     data/raw_claims.csv     every claim reported to the valuation date
     data/raw_assets.csv     the investment portfolio

  The files are generated by fixed rules (no random numbers), so every
  total can be reproduced exactly by hand, in R and in Excel.

  Three data problems are planted on purpose. Chapter 1's cleaning
  program has to find and fix them:
     1. Some policy records appear twice
     2. Some claims in one territory were loaded twice
     3. Some claims point to policies that do not exist
=====================================================================*/

%include "~/capital-adequacy-stress-testing/sas/00_setup.sas";

/*---------------------------------------------------------------------
  1. Policies: 40,000 annual policies, effective dates spread across
     2025 and 2026, in five territories
---------------------------------------------------------------------*/
data work.raw_policies;
   length policy_id 8 territory $8 eff_date exp_date annual_premium cancel_date 8;
   format eff_date exp_date cancel_date yymmdd10.;

   do i = 1 to 40000;
      policy_id = i;

      /* Territory mix: 45% Capital, 20% Southern, 15% Western,
         15% Eastern, 5% Northern */
      t = mod(i*7, 100);
      if t < 45 then territory = 'Capital';
      else if t < 65 then territory = 'Southern';
      else if t < 80 then territory = 'Western';
      else if t < 95 then territory = 'Eastern';
      else territory = 'Northern';

      /* Base annual premium by territory, plus up to $300 for driver profile */
      select (territory);
         when ('Capital')  base = 1400;
         when ('Southern') base = 1100;
         when ('Western')  base = 1050;
         when ('Eastern')  base = 1150;
         otherwise         base = 1300;
      end;
      annual_premium = base + 10*mod(i*13, 31);

      /* One-year policies starting any day in 2025 or 2026 */
      eff_date = '01JAN2025'd + mod(i*37, 730);
      exp_date = eff_date + 365;

      /* 1 in 50 policies cancelled 60 days after starting
         (only those starting by September 30, 2026) */
      if mod(i, 50) = 0 and eff_date <= '30SEP2026'd then cancel_date = eff_date + 60;
      else cancel_date = .;

      output;

      /* DATA PROBLEM 1: every 400th policy is recorded twice */
      if mod(i, 400) = 0 then output;
   end;

   keep policy_id territory eff_date exp_date annual_premium cancel_date;
run;

/*---------------------------------------------------------------------
  2. Claims: attempts 5,000 claims; a claim is kept only if its
     accident date falls inside the policy's coverage and on or before
     the valuation date
---------------------------------------------------------------------*/
data work.raw_claims;
   length claim_id policy_id accident_date paid_to_date case_reserve 8 claim_status $6;
   format accident_date yymmdd10.;

   do j = 1 to 5000;
      pid = mod(j*97, 40000) + 1;

      /* Re-derive that policy's details, using the same rules as above */
      t       = mod(pid*7, 100);
      western = (t >= 65 and t < 80);
      eff_d   = '01JAN2025'd + mod(pid*37, 730);
      exp_d   = eff_d + 365;
      if mod(pid, 50) = 0 and eff_d <= '30SEP2026'd then canc = eff_d + 60;
      else canc = .;

      /* Accident date and the last day the policy could have a claim */
      accident_date = eff_d + mod(j*53, 365);
      end_cover     = min(exp_d - 1, &valdate);
      if canc ne . then end_cover = min(end_cover, canc);

      if accident_date <= end_cover then do;
         /* Ultimate cost: $3,000 to $12,000; every 100th claim is a
            serious injury claim costing 20 times as much */
         ultimate = 3000 + 150*mod(j*17, 61);
         large    = (mod(j, 100) = 0);
         if large then ultimate = ultimate*20;

         /* How much has been paid so far */
         age = &valdate - accident_date;
         if large then paid_share = 0.3;
         else if age > 365 and mod(j, 5) ne 0 then paid_share = 1;
         else paid_share = 0.5;

         claim_id     = j;
         policy_id    = pid;
         paid_to_date = round(ultimate*paid_share, 0.01);
         case_reserve = ultimate - paid_to_date;
         if case_reserve > 0 then claim_status = 'Open';
         else claim_status = 'Closed';

         output;

         /* DATA PROBLEM 2: half of the Western territory's claims
            were loaded twice */
         if western and mod(j, 2) = 0 then output;
      end;
   end;

   /* DATA PROBLEM 3: ten claims point to policies that do not exist */
   do k = 1 to 10;
      claim_id      = 9000 + k;
      policy_id     = 90000 + k;
      accident_date = '15JUN2026'd;
      paid_to_date  = 0;
      case_reserve  = 5000;
      claim_status  = 'Open';
      output;
   end;

   keep claim_id policy_id accident_date paid_to_date case_reserve claim_status;
run;

/*---------------------------------------------------------------------
  3. Assets: 25 bonds, 3 equity funds and cash
     Bonds pay annual coupons and are valued at a yield of 3.5% plus a
     spread for the issuer type
---------------------------------------------------------------------*/
data work.raw_assets;
   length asset_id 8 asset_class $6 description $32 issuer_type $10
          face_value coupon_rate years_to_maturity bond_yield market_value 8;

   do k = 1 to 25;
      asset_id          = k;
      asset_class       = 'Bond';
      face_value        = 600000*(1 + mod(k*3, 4));
      coupon_rate       = 0.02 + 0.005*mod(k, 5);
      years_to_maturity = 1 + mod(k*7, 15);

      select (mod(k, 3));
         when (0) do; issuer_type = 'Federal';    spread = 0;     end;
         when (1) do; issuer_type = 'Provincial'; spread = 0.004; end;
         otherwise do; issuer_type = 'Corporate'; spread = 0.012; end;
      end;
      bond_yield  = 0.035 + spread;
      description = catx(' ', issuer_type, 'bond');

      /* Price = present value of coupons plus face value */
      pv = 0;
      do yr = 1 to years_to_maturity;
         pv = pv + coupon_rate*face_value/(1 + bond_yield)**yr;
      end;
      pv = pv + face_value/(1 + bond_yield)**years_to_maturity;
      market_value = round(pv, 0.01);
      output;
   end;

   /* Equity funds and cash have no bond details */
   call missing(issuer_type, face_value, coupon_rate, years_to_maturity, bond_yield);

   asset_id = 26; asset_class = 'Equity'; description = 'Canadian equity fund';
   market_value = 2500000; output;
   asset_id = 27; asset_class = 'Equity'; description = 'US equity fund';
   market_value = 2000000; output;
   asset_id = 28; asset_class = 'Equity'; description = 'International equity fund';
   market_value = 1500000; output;
   asset_id = 29; asset_class = 'Cash';   description = 'Cash and short-term deposits';
   market_value = 1500000; output;

   keep asset_id asset_class description issuer_type face_value coupon_rate
        years_to_maturity bond_yield market_value;
run;

/*---------------------------------------------------------------------
  4. Export the three raw files as CSV
---------------------------------------------------------------------*/
proc export data=work.raw_policies outfile="&root/data/raw_policies.csv" dbms=csv replace;
run;

proc export data=work.raw_claims outfile="&root/data/raw_claims.csv" dbms=csv replace;
run;

proc export data=work.raw_assets outfile="&root/data/raw_assets.csv" dbms=csv replace;
run;

/*---------------------------------------------------------------------
  5. Fingerprints: row counts and totals to check against expected values
---------------------------------------------------------------------*/
title "Raw file fingerprints";
proc sql;
   select 'Policies' as File length=8,
          count(*) as Rows format=comma10.,
          sum(annual_premium) as Check_total format=comma20.2
      from work.raw_policies
   union all
   select 'Claims', count(*), sum(case_reserve)
      from work.raw_claims
   union all
   select 'Assets', count(*), sum(market_value)
      from work.raw_assets;
quit;
title;